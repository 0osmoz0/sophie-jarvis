{
  "name": "sophie-jarvis",
  "version": "0.16.0",
  "description": "JARVIS Core — modular, permissioned tool execution foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:native": "node-gyp rebuild",
