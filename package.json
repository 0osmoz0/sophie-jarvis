{
  "name": "sophie-jarvis",
  "version": "0.8.0",
  "description": "JARVIS Core — modular, permissioned tool execution foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx tools/jarvis-core-smoke.ts",
    "smoke:observation": "tsx tools/jarvis-observation-smoke.ts",
    "audit:observation": "tsx tools/jarvis-observation-audit.ts",
    "smoke:files": "tsx tools/jarvis-file-control-smoke.ts",
    "audit:files": "tsx tools/jarvis-file-control-audit.ts",
    "smoke:apps": "tsx tools/jarvis-application-control-smoke.ts",
    "audit:apps": "tsx tools/jarvis-application-control-audit.ts",
    "smoke:macos": "tsx tools/jarvis-macos-application-backend-smoke.ts",
    "audit:macos": "tsx tools/jarvis-macos-backend-audit.ts",
    "smoke:screen": "tsx tools/jarvis-screen-observation-smoke.ts",
    "audit:screen": "tsx tools/jarvis-screen-observation-audit.ts",
    "smoke:presence": "tsx tools/jarvis-user-activity-smoke.ts",
    "audit:presence": "tsx tools/jarvis-user-activity-audit.ts",
    "smoke:actions": "tsx tools/jarvis-action-execution-smoke.ts",
    "audit:actions": "tsx tools/jarvis-action-execution-audit.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
